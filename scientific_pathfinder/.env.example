# ============================================================================
# Scientific Pathfinder — Environment Configuration
# ============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# ============================================================================

# ── Server Settings ─────────────────────────────────────────────────────
ENVIRONMENT=development          # development | staging | production
DEBUG=true
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO                   # DEBUG | INFO | WARNING | ERROR
LOG_FORMAT=text                  # text (dev) | json (production)

# ── CORS ────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ── Neo4j Database ──────────────────────────────────────────────────────
# For Neo4j Aura (cloud):
#   NEO4J_URI=neo4j+s://xxxxx.databases.neo4j.io
# For local Docker Neo4j:
#   NEO4J_URI=bolt://localhost:7687
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your_neo4j_password_here

# ── Groq LLM ───────────────────────────────────────────────────────────
# Get your key at: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# ── Semantic Scholar (Optional) ─────────────────────────────────────────
# Higher rate limits with an API key
# Get one at: https://www.semanticscholar.org/product/api
# SEMANTIC_SCHOLAR_API_KEY=your_key_here

# ── Security (Optional) ────────────────────────────────────────────────
# Set an API key to enable authentication (leave empty to disable)
# API_KEY=your_secret_api_key_here
# API_KEY_HEADER=X-API-Key

# Rate limiting (requests per minute)
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW=60
